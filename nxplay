#!/usr/bin/env bash
# Start a Switch game on the Mac through nxnative: build it once with
# scripts/build_ipa_from_nsp.py --platform mac, then reuse the run command the build printed.
#
# usage: nxplay [--rebuild] [--build-only] [--ipa] [--fps] [--lang <code>] <game folder> [extra build_ipa_from_nsp.py options...]
#   --build-only   build (when needed) and save the launcher, without starting the game
#   --ipa          build the iOS IPA instead, into the game folder (needs the NSPs)
#   --device <udid>  install on a device through Xcode instead: prepare the game's Xcode project, build it signed
#                  with your team (Xcode > Settings > Apple Accounts), install and start it; pass --team-id <id>
#                  (and --bundle-id) after the game folder
#   --fps          Apple's Metal performance HUD over the game (DM_METAL_HUD=1): frame rate, frame and GPU time, memory
#   --lang <code>  game language for this run (DM_LANG: en-US, ja, fr, de, zh-Hans, ...); it must be one the game has
# env:   NXNATIVE (repository, default ../nxnative beside this script), NX_KEYS (default ~/.switch/prod.keys)
set -euo pipefail

here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repo="${NXNATIVE:-$here/../nxnative}"
keys="${NX_KEYS:-$HOME/.switch/prod.keys}"
launcher_name=start_mac.sh

rebuild=0 fps=0 build_only=0 ipa=0 lang="" device=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --rebuild) rebuild=1; shift ;;
    --build-only) build_only=1; shift ;;
    --ipa) ipa=1; shift ;;
    --device) device="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    --fps) fps=1; shift ;;
    --lang) lang="${2:-}"; shift $(( $# > 1 ? 2 : 1 )) ;;
    *) break ;;
  esac
done
if [[ -n "$lang" && ! "$lang" =~ ^[A-Za-z]{2}(-[A-Za-z0-9]+)?$ ]]; then
  echo "nxplay: --lang wants a language code such as en-US, ja or zh-Hans, not '$lang'" >&2
  exit 2
fi
if [[ -n "$device" && ! "$device" =~ ^[0-9A-Fa-f-]+$ ]]; then
  echo "nxplay: --device wants a device UDID (xcrun devicectl list devices), not '$device'" >&2
  exit 2
fi
if [[ $# -lt 1 ]]; then
  echo "usage: $(basename "$0") [--rebuild] [--build-only] [--ipa | --device <udid>] [--fps] [--lang <code>] <game folder> [build_ipa_from_nsp.py options...]" >&2
  exit 2
fi
game="$(cd "$1" && pwd)"; shift

# Latest nxnative first; new commits make the saved launcher stale, so they force a rebuild
before="$(git -C "$repo" rev-parse HEAD)"
if git -C "$repo" pull --ff-only; then
  if [[ "$(git -C "$repo" rev-parse HEAD)" != "$before" ]]; then
    count="$(git -C "$repo" rev-list --count "$before..HEAD")"
    echo "nxnative updated: $count new commit$([[ $count == 1 ]] || echo s), rebuilding"
    git -C "$repo" --no-pager log --no-decorate --format='  %C(yellow)%h%C(reset) %s %C(dim)(%an, %ar)%C(reset)' -n 30 "$before..HEAD"
    if (( count > 30 )); then echo "  … and $(( count - 30 )) older"; fi
    rebuild=1
  fi
else
  echo "nxplay: git pull failed in $repo, going on with the current code" >&2
fi

if [[ $ipa -eq 1 ]]; then
  # the script's own default output (<game folder>/<the profile's IPA name>); it reuses every step a Mac build made
  cd "$repo"
  exec python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" ${lang:+--language "$lang"} "$@"
fi

# Stage lines in build_ipa_from_nsp.py's format, so the app's progress bar follows these steps too
stage() { stage_t0=$SECONDS; echo "[$(date +%T)] [$1/3] $2 …"; }
stage_done() { local s=$(( SECONDS - stage_t0 )); printf '[%s] ✓ [%s/3] %s (%d:%02d)\n' "$(date +%T)" "$1" "$2" $(( s / 60 )) $(( s % 60 )); }

if [[ -n "$device" ]]; then
  (cd "$repo" && python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" --prepare-xcode ${lang:+--language "$lang"} "$@")

  project=""
  for p in "$game"/*_build/xcode/DmIOS.xcodeproj; do
    [[ -d "$p" ]] && [[ -z "$project" || "$p" -nt "$project" ]] && project="$p"
  done
  if [[ -z "$project" ]]; then echo "nxplay: --prepare-xcode left no Xcode project in $game" >&2; exit 1; fi
  build="$(dirname "$(dirname "$project")")"
  schemes=("$project"/xcshareddata/xcschemes/*.xcscheme)   # one per game project: "<game name> (<title ID>)"
  scheme="$(basename "${schemes[0]}" .xcscheme)"
  app="$build/xcode-derived-data/Build/Products/Release-iphoneos/DmIOS.app"
  xlog="$build/logs/xcode_device.log"

  # the derived data Xcode uses for this project too; the first build copies the whole game into the app.
  # Built for any iPhone: a device destination needs the phone unlocked through the whole build
  stage 1 "Xcode build · $scheme"
  if ! xcodebuild -project "$project" -scheme "$scheme" -configuration Release -destination 'generic/platform=iOS' \
      -derivedDataPath "$build/xcode-derived-data" -allowProvisioningUpdates -allowProvisioningDeviceRegistration \
      build > "$xlog" 2>&1; then
    grep -E "error:|BUILD FAILED|requires a provisioning|No Account" "$xlog" | tail -20 || true
    echo "nxplay: xcodebuild failed; full log: $xlog" >&2
    exit 1
  fi
  stage_done 1 "Xcode build"

  stage 2 "install"
  xcrun devicectl device install app --device "$device" "$app"
  stage_done 2 "install"

  stage 3 "launch"
  bundle="$(/usr/libexec/PlistBuddy -c 'Print :CFBundleIdentifier' "$app/Info.plist")"
  if xcrun devicectl device process launch --device "$device" --terminate-existing "$bundle"; then
    stage_done 3 "launch"
  else
    echo "nxplay: installed; unlock the device and open the app (it could not be started from here)"
  fi
  exit 0
fi

# The newest <title ID>_build/start_mac.sh whose Mac host is still there
find_launcher() {
  local best="" f
  for f in "$game"/*_build/"$launcher_name"; do
    [[ -f "$f" && -x "$(dirname "$f")/tools/dmhost" ]] || continue
    [[ -z "$best" || "$f" -nt "$best" ]] && best="$f"
  done
  echo "$best"
}

# The launcher holds absolute paths (the build printed them): after the game folder or nxnative moved,
# point them at where they are now. The build folder is the launcher's own; it was the parent of `cd <build>/run`.
relocate() {
  python3 - "$1" "$repo" <<'PY'
import os, re, shlex, sys
path, repo = sys.argv[1], os.path.abspath(sys.argv[2])
build = os.path.dirname(os.path.abspath(path))
lines = open(path).read().splitlines()
i = next(i for i, line in enumerate(lines) if line.startswith('cd '))
tokens = shlex.split(lines[i])
old = os.path.dirname(tokens[1])

def fix(value):
    if value == old or value.startswith(old + '/'):
        return build + value[len(old):]
    games = re.search(r'/dm/games/.*$', value)   # a profile table of the nxnative checkout
    if games and not os.path.exists(value) and os.path.exists(repo + games.group(0)):
        return repo + games.group(0)
    return value

# rebuilt the way build_ipa_from_nsp.py writes it: cd <run> && KEY=value ... <host> <patched>
words = []
for token in tokens:
    if token == '&&':
        words.append(token)
    elif re.match(r'[A-Za-z_]\w*=', token):
        key, value = token.split('=', 1)
        words.append(f'{key}={shlex.quote(fix(value))}')
    else:
        words.append(shlex.quote(fix(token)))
cmd = ' '.join(words)
if cmd != lines[i]:
    lines[i] = cmd
    open(path, 'w').write('\n'.join(lines) + '\n')
    print(f'launcher moved: paths now under {build}')
PY
}

start() {
  if [[ $build_only -eq 1 ]]; then exit 0; fi
  if [[ $fps -eq 1 ]]; then export DM_METAL_HUD=1; fi
  if [[ -n "$lang" ]]; then
    # the launcher sets DM_LANG inline, which beats the environment: swap the value in its command
    echo "game language: $lang"
    export DM_LANG="$lang"
    exec bash -c "$(sed -E "s/(^| )DM_LANG=[^ ]*/\1DM_LANG=$lang/" "$1")"
  fi
  exec bash "$1"
}

if [[ $rebuild -eq 0 ]]; then
  launcher="$(find_launcher)"
  if [[ -n "$launcher" ]]; then
    echo "already built: $launcher (--rebuild to build again)"
    relocate "$launcher"
    start "$launcher"
  fi
fi

log="$(mktemp -t nxplay)"
trap 'rm -f "$log"' EXIT

# tee makes stdout a pipe: keep the in-place progress bar and the console width the script would see in a terminal
progress=()
if [[ -t 1 ]]; then
  progress=(--progress bar)
  export COLUMNS="${COLUMNS:-$(tput cols 2>/dev/null || echo 80)}"
fi

(cd "$repo" && python3 scripts/build_ipa_from_nsp.py "$game" -k "$keys" --platform mac ${progress[@]+"${progress[@]}"} "$@") | tee "$log"

# The run command is the line after "done: the game runs on the Mac with this command";
# drop the bar's carriage-return redraws in front of it.
cmd="$(awk '{ sub(/.*\r/, "") } found { print; exit } /done: the game runs on the Mac with this command/ { found = 1 }' "$log")"
if [[ "$cmd" != cd\ * ]]; then
  echo "nxplay: no run command in the build output" >&2
  exit 1
fi

# "cd <id>_build/run && ...": the launcher goes into <id>_build
run_dir="$(python3 -c 'import shlex, sys; print(shlex.split(sys.argv[1])[1])' "$cmd")"
launcher="$(dirname "$run_dir")/$launcher_name"
printf '#!/bin/sh\n# written by nxplay from the build output\n%s\n' "$cmd" > "$launcher"
chmod +x "$launcher"

echo "saved: $launcher"
rm -f "$log"   # exec skips the EXIT trap
start "$launcher"
